# —— 构建产物 ——
# ⚠ 目录规则一律用根锚定（/build/ 而不是 build/）：裸 build/、export/、gen/
#   会匹配到任意层级的同名目录，曾把 src/engine/export/** 整块排除在仓库外。
/build/
cmake-build-*/
/out/
*.o
*.obj
*.lib
*.a
*.exe
*.dll
*.pdb
*.ilk
*.exp

# —— 缓存与日志 ——
/cache/
/logs/
*.log
*.crash

# —— IDE ——
.vscode/
.idea/
*.user

# —— 生成的头文件 ——
/gen/

# —— 导出产物 ——
/export/
*.png
*.bmp
*.tga
*.ppm
*.obj
*.mtl
*.pov
*.stl
*.mlscene
*.mlrepr

# —— 运行时状态（应用写出，非源码）——
# imgui.ini：Dock 布局/窗口位置的运行期快照，随用户操作变化，不应入库
# （布局的持久化由 persist/settings 的 settings.json 负责）
imgui.ini
imgui.ini.bak

# —— 系统 ——
Thumbs.db
.DS_Store
/other/

# —— 文档插图（docs 下必须入库，其余 png 仍视为导出产物）——
!docs/figs_v2/*.png
!docs/figs_v2/**/*.png

# —— 例外：data/ 下的结构夹具（PDB 结构文件不是调试符号 .pdb）——
!data/*.pdb

# —— 本地环境 / 临时缓存（不入库）——
.venv/
__pycache__/
build_agent/
build_style/
build_*/
vcpkg_installed/
_test/
_testtmp/
.monitor/
_esp/
_aclrepair/
.dsh-progress/
test_export*
/软件注册/
